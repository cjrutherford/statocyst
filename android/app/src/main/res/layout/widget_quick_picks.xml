<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/picks_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="3dp"
        android:paddingBottom="2dp"
        android:text="@string/widget_quick_picks"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/picks_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="3dp"
        android:text="@string/widget_no_picks"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

        <LinearLayout
            android:id="@+id/picks_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/pick_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <ImageView
                    android:id="@+id/pick_1_art"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/pick_1_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pick_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <ImageView
                    android:id="@+id/pick_2_art"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/pick_2_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pick_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <ImageView
                    android:id="@+id/pick_3_art"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/pick_3_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pick_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <ImageView
                    android:id="@+id/pick_4_art"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/pick_4_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/picks_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/pick_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <ImageView
                    android:id="@+id/pick_5_art"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/pick_5_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pick_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <ImageView
                    android:id="@+id/pick_6_art"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/pick_6_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pick_7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <ImageView
                    android:id="@+id/pick_7_art"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/pick_7_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pick_8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <ImageView
                    android:id="@+id/pick_8_art"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/pick_8_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
</LinearLayout>
