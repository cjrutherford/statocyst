<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/widget_art" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="@null" android:scaleType="fitCenter" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:letterSpacing="0.14" android:maxLines="1" android:textAllCaps="true"
            android:text="@string/widget_eyebrow_idle" android:textColor="@color/widget_cyan" android:textSize="9sp" />
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1"
            android:text="@string/widget_nothing_playing" android:textColor="@color/widget_text" android:textSize="15sp" />
            <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/widget_prev" android:layout_width="32dp" android:layout_height="32dp"
            android:background="@null" android:contentDescription="@string/widget_previous" android:src="@drawable/ic_widget_prev" />
        <ImageButton android:id="@+id/widget_play_pause" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
            android:background="@drawable/widget_play_bg" android:contentDescription="@string/widget_play" android:padding="8dp" android:src="@drawable/ic_widget_play_dark" />
        <ImageButton android:id="@+id/widget_next" android:layout_width="32dp" android:layout_height="32dp"
            android:background="@null" android:contentDescription="@string/widget_next" android:src="@drawable/ic_widget_next" />
    </LinearLayout><ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="4dp" android:contentDescription="@null" android:background="@drawable/widget_divider" /><TextView android:id="@+id/widget_fav_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:letterSpacing="0.14" android:maxLines="1" android:textAllCaps="true"
            android:text="@string/widget_top_favorites" android:textColor="@color/widget_cyan" android:textSize="9sp" android:layout_marginBottom="2dp" /><TextView android:id="@+id/widget_fav_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/widget_no_favorites" android:textColor="@color/widget_dim" android:textSize="12sp" android:visibility="gone" /><TextView android:id="@+id/widget_fav_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="@color/widget_text" android:textSize="13sp" /><TextView android:id="@+id/widget_fav_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="@color/widget_text" android:textSize="13sp" /><TextView android:id="@+id/widget_fav_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="@color/widget_text" android:textSize="13sp" /><TextView android:id="@+id/widget_fav_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="@color/widget_text" android:textSize="13sp" />
</LinearLayout>
