<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_note" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_nothing_playing"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@null"
            android:contentDescription="@string/widget_previous"
            android:src="@drawable/ic_widget_prev" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@null"
            android:contentDescription="@string/widget_play"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@null"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_fav_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:text="@string/widget_top_favorites"
        android:textColor="#80FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_fav_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_no_favorites"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_fav_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/widget_fav_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/widget_fav_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/widget_fav_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
