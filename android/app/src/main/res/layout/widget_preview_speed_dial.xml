            <ImageView android:layout_width="54dp" android:layout_height="54dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_preview_art_1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center_horizontal" android:maxLines="1" android:text="@string/widget_preview_art_1" android:textColor="@color/widget_text" android:textSize="10sp" />
        </LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="3dp" android:paddingEnd="3dp">
            <ImageView android:layout_width="54dp" android:layout_height="54dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_preview_art_2" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center_horizontal" android:maxLines="1" android:text="@string/widget_preview_art_2" android:textColor="@color/widget_text" android:textSize="10sp" />
        </LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="3dp" android:paddingEnd="3dp">
            <ImageView android:layout_width="54dp" android:layout_height="54dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_preview_art_3" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center_horizontal" android:maxLines="1" android:text="@string/widget_preview_art_3" android:textColor="@color/widget_text" android:textSize="10sp" />
        </LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="3dp" android:paddingEnd="3dp">
            <ImageView android:layout_width="54dp" android:layout_height="54dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_preview_art_4" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center_horizontal" android:maxLines="1" android:text="@string/widget_preview_art_4" android:textColor="@color/widget_text" android:textSize="10sp" />
        </LinearLayout></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:orientation="horizontal"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="3dp" android:paddingEnd="3dp">
            <ImageView android:layout_width="54dp" android:layout_height="54dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_preview_art_1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center_horizontal" android:maxLines="1" android:text="@string/widget_preview_art_5" android:textColor="@color/widget_text" android:textSize="10sp" />
        </LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="3dp" android:paddingEnd="3dp">
            <ImageView android:layout_width="54dp" android:layout_height="54dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_preview_art_2" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center_horizontal" android:maxLines="1" android:text="@string/widget_preview_art_6" android:textColor="@color/widget_text" android:textSize="10sp" />
        </LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="3dp" android:paddingEnd="3dp">
            <ImageView android:layout_width="54dp" android:layout_height="54dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_preview_art_3" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center_horizontal" android:maxLines="1" android:text="@string/widget_preview_art_7" android:textColor="@color/widget_text" android:textSize="10sp" />
        </LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="3dp" android:paddingEnd="3dp">
            <ImageView android:layout_width="54dp" android:layout_height="54dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_preview_art_4" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center_horizontal" android:maxLines="1" android:text="@string/widget_preview_art_8" android:textColor="@color/widget_text" android:textSize="10sp" />
        </LinearLayout></LinearLayout></LinearLayout>
</LinearLayout>
