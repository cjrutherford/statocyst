<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dial_item" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="3dp" android:paddingEnd="3dp">
    <ImageView android:id="@+id/dial_item_art" android:layout_width="54dp" android:layout_height="54dp"
        android:contentDescription="@null" android:scaleType="fitCenter" />
    <TextView android:id="@+id/dial_item_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center_horizontal" android:maxLines="1"
        android:textColor="@color/widget_text" android:textSize="10sp" />
</LinearLayout>
