{
  "name": "jellyfin-client",
  "projectType": "library",
  "sourceRoot": "libs/jellyfin-client/src",
  "tags": ["type:integration", "scope:desktop"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/jellyfin-client/vitest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc-rs --noEmit -p libs/jellyfin-client/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
