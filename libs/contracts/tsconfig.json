{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2023"],
    "strict": true
  },
  "include": ["src/**/*.ts", "schema/**/*.json", "fixtures/**/*.json", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
