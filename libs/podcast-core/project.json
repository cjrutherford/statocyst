{
  "name": "podcast-core",
  "projectType": "library",
  "sourceRoot": "libs/podcast-core/src",
  "tags": ["type:library", "scope:shared"],
  "implicitDependencies": ["contracts"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/podcast-core/vitest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc-rs --noEmit -p libs/podcast-core/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
