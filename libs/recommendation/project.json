{
  "name": "recommendation",
  "projectType": "library",
  "sourceRoot": "libs/recommendation/src",
  "tags": ["type:runtime-core", "scope:shared"],
  "implicitDependencies": ["contracts", "playback-core"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/recommendation/vitest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc-rs --noEmit -p libs/recommendation/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
